{
  "editor.tabSize": 2,
  "editor.fontSize": 14,
  "editor.minimap.enabled": false,
  "editor.wordWrap": "off",
  "editor.linkedEditing": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "editor.multiCursorModifier": "ctrlCmd",
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "workbench.editor.enablePreview": false,
  "html.format.enable": false,
  "search.exclude": {
    "**/node_modules": false,
    "**/bower_components": true,
    "**/.git": true,
    "**/.DS_Store": true,
    "**/tmp": true,
    "**/coverage": true,
    "**/build": true,
    "**/Pods": true,
    "**/*.xcodeproj": true,
    "**/*.xcworkspace": true,
    "**/.meteor": true
  },
  "cSpell.userWords": [
    "adpyke",
    "apexcharts",
    "appcpdate",
    "axios",
    "bigserial",
    "camelcase",
    "cannonical",
    "classname",
    "clsx",
    "corretto",
    "countup",
    "curations",
    "dday",
    "deactive",
    "editnote",
    "ellipsize",
    "fastapi",
    "firestore",
    "firstload",
    "flatform",
    "fontsource",
    "froala",
    "grannysmithapple",
    "gtag",
    "iconify",
    "imperialred",
    "isbot",
    "jscookie",
    "KAKAO",
    "linebreak",
    "lottiefiles",
    "maximumbluepurple",
    "mixins",
    "mylist",
    "mypage",
    "neondatabase",
    "nestjs",
    "nextjs",
    "nextui",
    "nodenext",
    "nuxt",
    "nuxtjs",
    "Occured",
    "opentype",
    "Outro",
    "Parens",
    "pinia",
    "Pipeable",
    "plusplus",
    "portlandorange",
    "Pressable",
    "Pretendard",
    "pydantic",
    "raisinblack",
    "recordid",
    "roboto",
    "signin",
    "signout",
    "signup",
    "smallint",
    "stibee",
    "stylelint",
    "supabase",
    "Swiper",
    "tailwindcss",
    "tanstack",
    "tealblue",
    "testid",
    "tinyint",
    "Toastification",
    "tosspayments",
    "typecheck",
    "typedjson",
    "typeorm",
    "uiball",
    "upsert",
    "upserting",
    "valibot",
    "varchar",
    "vaul",
    "vuejs",
    "vuepic",
    "vuetify",
    "vuex",
    "vuexfire",
    "xaxis",
    "xaxistooltip",
    "xlarge",
    "xsmall",
    "xxlarge",
    "xxsmall",
    "zustand",
    "bookread",
    "readed",
    "momentar",
    "Regist",
    "Podfile",
    "RNF",
    "SENDBIRD",
    "CHANNELTALK",
    "prebuild",
    "vibin",
    "gorhom",
    "noonu",
    "datetimepicker",
    "mapx",
    "mapy",
    "jetpack",
    "latlng",
    "sourcecrs",
    "targetcrs",
    "Iframe",
    "Iframely",
    "jibun",
    "igsh",
    "youtu",
    "devclient",
    "iamport",
    "miblanchard",
    "noru"
  ],
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "react-native-tools.showUserTips": false,
  "typescript.tsdk": "node_modules/typescript/lib",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit"
    }
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[sql]": {
    "editor.defaultFormatter": "adpyke.vscode-sql-formatter"
  },
  "[javascript][typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll.stylelint": "explicit"
    }
  },
  "sql-formatter.uppercase": true,
  "eslint.debug": true,
  "eslint.trace.server": "off",
  "eslint.probe": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "html",
    "vue",
    "markdown"
  ],
  "files.associations": {
    "*.tsx": "typescriptreact",
    "*.ts": "typescriptreact"
  },
  "window.commandCenter": false
}
