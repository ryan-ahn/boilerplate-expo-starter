{
  "name": "boilerplate-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "doctor": "expo-doctor",
    "check": "npm run type-check && npm run lint-check",
    "lint-check": "expo lint",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=libs/drizzle/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=libs/drizzle/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=libs/drizzle/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=libs/drizzle/drizzle.config.ts",
    "db:pull": "drizzle-kit pull --config=libs/drizzle/drizzle.config.ts",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:android": "expo prebuild --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.108.2",
    "dayjs": "^1.11.21",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.33",
    "expo-apple-authentication": "^56.0.4",
    "expo-application": "^56.0.3",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "^56.0.19",
    "expo-linking": "~8.0.11",
    "expo-location": "^56.0.18",
    "expo-router": "~6.0.23",
    "expo-share-extension": "^5.0.6",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.3",
    "react-native-touchable-scale": "^2.2.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "~19.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-doctor": "^1.19.10",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-share-extension"
        ]
      }
    }
  },
  "private": true
}
